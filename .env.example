# Optional - leave blank to skip LLM scoring/tailored bullets and run on
# rule-based scoring only (radar/scoring.py). Nothing else depends on this.
ANTHROPIC_API_KEY=
RADAR_LLM_MODEL=claude-opus-5

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
DIGEST_TO=

# Optional - aggregator job APIs (candidate.yaml adzuna/careerjet sources).
# Each source is skipped cleanly if its credentials are unset.
# Adzuna: free, https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Careerjet: free API key from a Publisher account
# https://www.careerjet.com/partners/register/as-publisher
CAREERJET_API_KEY=
