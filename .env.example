# Optional - leave blank to skip LLM scoring/tailored bullets and run on
# rule-based scoring only (radar/scoring.py). Nothing else depends on this.
ANTHROPIC_API_KEY=
# Optional override; otherwise llm.model in profile/scoring.yaml is used.
RADAR_LLM_MODEL=

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
DIGEST_TO=

# Optional - aggregator job APIs (sources.yaml adzuna/careerjet sources).
# Each source is skipped cleanly if its credentials are unset.
# Adzuna: free, https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JSearch (Google for Jobs -> Indeed/LinkedIn/Glassdoor). Free RapidAPI
# account, no website needed. https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Careerjet: disabled by default - the Publisher program needs a live website
# that displays their listings. https://www.careerjet.com/partners/
CAREERJET_API_KEY=
